  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Goal:</b> build one tower together. When it collapses, whoever placed
    the last block loses that game and everyone else scores 1 point. <b>First to
    3 points wins.</b>



    <b>Start of every game:</b> each player places 1 block
    of their choice. Pick it from the bar at the bottom of the screen.



    <b>Each
    round</b>

    1. <b>Event</b> - the first player draws an event card. It changes
    something this round. To see what every event card does, press <b>Cards (C)</b>.

    2.
    <b>Draw</b> - everyone draws a block card. That is the block you place.

    3.
    <b>Build</b> - take turns placing your block on the tower.

    4. <b>Shake</b>
    - the first player starts the shake.

    5. <b>Check</b> - if the tower collapsed,
    the game is over. If not, the next player clockwise becomes the first player
    and a new round starts.



    The top of the screen always says whose turn it
    is and what to do.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
